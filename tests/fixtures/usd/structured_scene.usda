#usda 1.0
(
    defaultPrim = "Robot"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend payload = @structured_payload.usda@</RobotPayload>
)
{
    def Scope "PhysicsOnly"
    {
        def PhysicsScene "Scene"
        {
        }

        def PhysicsRevoluteJoint "KneeJoint"
        {
        }

        def Scope "Actuators"
        {
            def "KneeDrive"
            {
                custom float stiffness = 100
            }
        }
    }
}
