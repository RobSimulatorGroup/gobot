#usda 1.0
(
    defaultPrim = "RobotPayload"
)

def Xform "RobotPayload"
{
    double3 xformOp:translate = (1, 2, 3)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Visual" (
            prepend references = @structured_reference.usda@</ReferencedVisual>
        )
        {
        }
    }

    def Scope "PayloadMetadata"
    {
        custom string source = "not scene content"
    }
}
