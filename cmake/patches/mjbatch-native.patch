+template<class F> void CheckedCall(F fn, mjModel* m, mjData* d) {
+  std::jmp_buf jb;
+  auto* previous = tls_jmp;
+  tls_jmp = &jb;
+  if (setjmp(jb) == 0) {
+    fn(m, d);
+    tls_jmp = previous;
+  } else {
+    tls_jmp = previous;
+    throw std::runtime_error(tls_error);
